{
  "expo": {
    "name": "uru-mobiles-recipes-app",
    "slug": "uru-mobiles-recipes-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "urumobilesrecipesapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "API_URL_COOKBOOK": "https://app-blq-blockages-efabcmf8h5e6g9br.eastus2-01.azurewebsites.net",
      "API_URL_INTEGRATIONS": "https://app-blq-integrations-awajh4hzbpfjcuah.eastus2-01.azurewebsites.net",
      "AAD_SCOPE": "api://70e4e217-55f4-4121-a5c2-abb650012fae/.default"
    }
  }
}
